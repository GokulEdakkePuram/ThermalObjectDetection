# The FLIR download, as it ships. Read-only input, ~18 GB.
Dataset/

# Everything the pipeline builds out of it: one Ultralytics tree per
# preprocessing arm, plus the data YAML that points at it. All regenerated by
# `thermaldet convert`, so none of it belongs in git.
data/
configs/data/

# Training artifacts
runs/
weights/
logs/
*.pt
*.onnx
*.mlpackage/
*.torchscript
# ...but keep the released checkpoint.
!models/*.pt

# reports/ is regenerated by `thermaldet profile` and `thermaldet eval`; the
# numbers worth keeping are transcribed into docs/ alongside what they mean.
reports/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# OS / editor
.DS_Store
.idea/
.vscode/
